# dc_timesync.service per-node config. Copy to <SERVER_RUN_DIR>/dc_timesync.env
# on each node (KEY="value", 0644), then: systemctl enable --now dc_timesync.service
#
# Fabric netdev whose NIC PHC we hw-timestamp against (e.g. an mlx5 port).
DC_TIMESYNC_IFACE="enp3s0f0np0"
# This node's id, and the id of the node acting as the shared time reference.
DC_TIMESYNC_SELF_ID="2"
DC_TIMESYNC_REF_ID="1"
# Reference node's link-local IPv6 on the SAME fabric iface, bare (no %zone --
# the scope is taken from DC_TIMESYNC_IFACE). Leave EMPTY on the reference node
# itself (SELF_ID == REF_ID); required on every other node.
DC_TIMESYNC_REF_LL="fe80::1"
# Measurement/publish cadence in ms (optional; daemon default 1000).
DC_TIMESYNC_CADENCE_MS="1000"
# Optional: override the mmap snapshot path the server reads
# (default /dev/shm/dc_timesync.snapshot).
#DC_TIMESYNC_SNAPSHOT="/dev/shm/dc_timesync.snapshot"
